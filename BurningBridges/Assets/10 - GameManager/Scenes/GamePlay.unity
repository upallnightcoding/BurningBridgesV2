  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "In the valley of Chasin, villagers gather to witness a race across the
    shattered isles.\r\nOne by one, challengers step forward, each seeking the glory
    of reaching the distant Ikola Castle.\r\nBut this is no ordinary race. The path
    twists through a labyrinth of fragile bridges \u2014 each a gamble between triumph
    and ruin. <br>\r\nUse the arrow keys or your controller to guide your hero. But
    tread carefully: some bridges are rigged to explode, chipping away at your life
    with every careless step. Others are guarded by cursed skulls that hurl deadly
    projectiles in hopes to end your quest. <br>\r\nBut above all, beware of the
    restless dead \u2014 skeletons and goblins who strike without mercy. <br>\r\nBut
    you are not without defense. Two weapons stand between you and oblivion. <br>\r\nAim
    true, and victory may be yours. <br>\r\nAim poorly, and the valley will never
    remember your name.\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fcfcd7da3c44c554db6791d28dd79a59, type: 2}
  m_sharedMaterial: {fileID: -6627135030329028012, guid: fcfcd7da3c44c554db6791d28dd79a59, type: 2}
